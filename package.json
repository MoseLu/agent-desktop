{
  "name": "agent-desktop",
  "version": "1.0.0",
  "description": "AI Desktop Agent powered by Claude",
  "main": "electron/main.js",
  "scripts": {
    "dev:proxy": "node proxy-service.js",
    "dev:vite": "vite",
    "dev:electron": "npx wait-on http://localhost:5173 && electron .",
    "dev": "node scripts/dev-runner.js",
    "dev:all": "concurrently -k \"pnpm dev:proxy\" \"pnpm dev:vite\" \"pnpm dev:electron\"",
    "start": "concurrently -k \"pnpm dev:proxy\" \"pnpm dev:vite\" \"pnpm dev:electron\"",
    "build": "vite build && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@anthropic-ai/sdk": "^0.39.0",
    "antd": "^6.3.1",
    "electron-store": "^10.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "fast-glob": "^3.3.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.7.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^6.0.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-svgr": "^4.5.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.agent.desktop",
    "productName": "Agent Desktop",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "category": "public.app-category.productivity"
    }
  },
  "packageManager": "pnpm@9.6.0+sha512.38dc6fba8dba35b39340b9700112c2fe1e12f10b17134715a4aa98ccf7bb035e76fd981cf0bb384dfa98f8d6af5481c2bef2f4266a24bfa20c34eb7147ce0b5e"
}
